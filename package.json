{
  "name": "@absolutejs/git",
  "version": "0.13.0",
  "description": "Provider-neutral authenticated Git source ingestion, webhook normalization, exact-revision materialization, and provenance for Bun and AbsoluteJS.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/absolutejs/git.git"
  },
  "homepage": "https://github.com/absolutejs/git",
  "bugs": {
    "url": "https://github.com/absolutejs/git/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "BSL-1.1",
  "author": "Alex Kahn",
  "absolutejs": {
    "manifestContract": 1
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./azure-devops": {
      "types": "./dist/azure-devops.d.ts",
      "import": "./dist/azure-devops.js",
      "default": "./dist/azure-devops.js"
    },
    "./azure-devops-user": {
      "types": "./dist/azure-devops-user.d.ts",
      "import": "./dist/azure-devops-user.js",
      "default": "./dist/azure-devops-user.js"
    },
    "./bitbucket": {
      "types": "./dist/bitbucket.d.ts",
      "import": "./dist/bitbucket.js",
      "default": "./dist/bitbucket.js"
    },
    "./bitbucket-user": {
      "types": "./dist/bitbucket-user.d.ts",
      "import": "./dist/bitbucket-user.js",
      "default": "./dist/bitbucket-user.js"
    },
    "./checkout": {
      "types": "./dist/checkout.d.ts",
      "import": "./dist/checkout.js",
      "default": "./dist/checkout.js"
    },
    "./gitea": {
      "types": "./dist/gitea.d.ts",
      "import": "./dist/gitea.js",
      "default": "./dist/gitea.js"
    },
    "./gitea-user": {
      "types": "./dist/gitea-user.d.ts",
      "import": "./dist/gitea-user.js",
      "default": "./dist/gitea-user.js"
    },
    "./github": {
      "types": "./dist/github.d.ts",
      "import": "./dist/github.js",
      "default": "./dist/github.js"
    },
    "./github-app": {
      "types": "./dist/github-app.d.ts",
      "import": "./dist/github-app.js",
      "default": "./dist/github-app.js"
    },
    "./github-app-user": {
      "types": "./dist/github-app-user.d.ts",
      "import": "./dist/github-app-user.js",
      "default": "./dist/github-app-user.js"
    },
    "./gitlab": {
      "types": "./dist/gitlab.d.ts",
      "import": "./dist/gitlab.js",
      "default": "./dist/gitlab.js"
    },
    "./gitlab-user": {
      "types": "./dist/gitlab-user.d.ts",
      "import": "./dist/gitlab-user.js",
      "default": "./dist/gitlab-user.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js",
      "default": "./dist/manifest.js"
    },
    "./manifest.json": "./dist/manifest.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/github.ts src/github-app.ts src/github-app-user.ts src/gitlab.ts src/gitlab-user.ts src/bitbucket.ts src/bitbucket-user.ts src/gitea.ts src/gitea-user.ts src/azure-devops.ts src/azure-devops-user.ts src/checkout.ts src/manifest.ts --outdir dist --root src --sourcemap --target=bun --external @absolutejs/manifest --external @sinclair/typebox --external @sinclair/typebox/value && tsc --project tsconfig.build.json && absolute-manifest emit",
    "test": "bun test tests/",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"./**/*.{ts,json,md}\"",
    "check:package": "bun run typecheck && bun run build && bun run check:exports && bun run test",
    "release": "bun run format && bun run check:package && bun publish",
    "check:exports": "bun run scripts/check-exports.ts"
  },
  "keywords": [
    "absolutejs",
    "bun",
    "git",
    "github",
    "webhook",
    "provenance",
    "deployment"
  ],
  "dependencies": {
    "@absolutejs/linked-providers": "0.0.5",
    "@absolutejs/manifest": "0.9.0",
    "@sinclair/typebox": "^0.34.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  }
}
